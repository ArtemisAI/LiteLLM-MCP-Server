{
  "servers": {
    "litellm-manager": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "exec",
        "-i",
        "litellm_mcp",
        "node",
        "dist/index.js"
      ],
      "env": {
        "LITELLM_API_BASE": "http://localhost:4001",
        "LITELLM_MASTER_KEY": "your-master-key-here",
        "DEBUG": "false"
      }
    }
  }
}
